# Environment configuration for Weather Dashboard (Frontend)
# Copy to .env and adjust values per environment.

# Base URL for backend weather API (e.g., https://api.example.com)
REACT_APP_API_BASE=

# Comma-separated feature flags. Enable mock data mode with: mockWeather=true
# When enabled or when API base is empty, the app will use built-in mock responses.
REACT_APP_FEATURE_FLAGS=mockWeather=true

# Optional standard variables already present in the environment (documented for visibility)
REACT_APP_NODE_ENV=development
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_LOG_LEVEL=info
