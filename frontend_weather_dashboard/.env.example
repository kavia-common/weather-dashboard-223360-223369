# Frontend Environment Example

# Base URL for weather API backend/proxy (no trailing slash recommended)
REACT_APP_API_BASE=http://localhost:8080

# Default city loaded on app start
REACT_APP_DEFAULT_CITY=San Francisco

# Existing keys (preserved placeholders)
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=true
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/health
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
