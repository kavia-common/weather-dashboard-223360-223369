# Frontend Weather Dashboard - Environment Variables Example
# Copy this file to ".env" and set the values for your environment.

# Base URL of your backend weather API (include scheme: http:// or https://), no trailing slash.
# Example: https://weather-api.example.com
REACT_APP_API_BASE=

# Optional: Alternative backend URL key if your environment uses this
REACT_APP_BACKEND_URL=

# Optional: Feature flags (comma-separated key=value). Example: MOCK_WEATHER=false
REACT_APP_FEATURE_FLAGS=MOCK_WEATHER=false

# Optional: Node environment override for UI display
REACT_APP_NODE_ENV=development

# Notes:
# - Geolocation requires HTTPS or localhost in browsers due to security.
# - Ensure your backend exposes endpoints:
#     GET /weather?query=<city-or-lat,lon>
#     GET /weather?lat=<lat>&lon=<lon>
#   and returns JSON with either the normalized shape:
#     { location, current: { temp, condition, humidity, wind, icon }, forecast: [...] }
#   or a mappable shape (see normalizeWeatherPayload in src/services/apiClient.js).
